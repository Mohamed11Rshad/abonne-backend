# Application
PORT=3000
NODE_ENV=development

# Database (PostgreSQL / Drizzle)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/abonne_db
DB_MAX_CONNECTIONS=10

# Security & Encryption
ENCRYPTION_KEY=your_encryption_key_here
HMAC_KEY=your_hmac_secret_key_here
SALT_ROUNDS=10

# Cloudinary
CLOUDNAIRY_CLOUD_NAME=
CLOUDNAIRY_API_KEY=
CLOUDNAIRY_API_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# JWT Authentication
ACCESS_TOKEN_SECRET=your_jwt_access_secret_key_here
REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# Evolution API (WhatsApp)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=YOUR_SUPER_SECRET_GLOBAL_API_KEY
EVOLUTION_INSTANCE=abone

